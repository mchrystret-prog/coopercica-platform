From 910908ad614064eeacfdb79e3098e5e8a038af6c Mon Sep 17 00:00:00 2001
From: mchrystret-prog <mchrystret@gmail.com>
Date: Tue, 6 Oct 2026 18:26:27 +0000
Subject: [PATCH 1/2] feat(leitor): tema escuro no leitor de PDF
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Fundo escuro baseado nos tokens de dispositivo (#101010), toolbar, miniaturas e menu de compartilhar adaptados, color-scheme: dark e placeholder escuro no iframe. A página do PDF continua branca.
---
 public/reader.css       | 88 ++++++++++++++++++++++++++++++++++++++++-
 public/reader.html      |  2 +-
 styles/publications.css |  2 +-
 3 files changed, 89 insertions(+), 3 deletions(-)

diff --git a/public/reader.css b/public/reader.css
index f654fe9..542228f 100644
--- a/public/reader.css
+++ b/public/reader.css
@@ -1 +1,87 @@
